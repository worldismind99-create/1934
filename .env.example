# 各サービスの開発者ポータルで作成したアプリの認証情報を設定する。
# 3サービスすべて必須ではなく、設定したサービスだけ連携が有効になる。

# ---- 共通 ----
# サーバーのポート番号
PORT=3000
# 公開URL(ngrok等を使う場合はそのURL)。各リダイレクトURIの既定値の元になる
BASE_URL=http://localhost:3000

# ---- Instagram ----
# Meta for Developers (https://developers.facebook.com/) のアプリダッシュボード
# > Instagram > API setup with Instagram login に表示される値
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# アプリ設定の「OAuth Redirect URIs」に登録したURI(https必須)
INSTAGRAM_REDIRECT_URI=https://example.com/auth/callback

# ---- TikTok ----
# TikTok for Developers (https://developers.tiktok.com/) のアプリ管理画面の値。
# Login Kit を追加し、Redirect URI を登録すること
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://example.com/auth/tiktok/callback

# ---- X (旧Twitter) ----
# X Developer Portal (https://developer.x.com/) のアプリ設定
# > User authentication settings で OAuth 2.0 を有効化した際の値。
# Type of App が「Confidential client」の場合のみ X_CLIENT_SECRET を設定する
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://example.com/auth/x/callback
