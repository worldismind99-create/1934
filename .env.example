# Meta for Developers (https://developers.facebook.com/) で作成したアプリの情報を設定する
# アプリダッシュボード > Instagram > API setup with Instagram login に表示される値

# InstagramアプリID
INSTAGRAM_APP_ID=

# Instagramアプリシークレット(絶対に公開しないこと)
INSTAGRAM_APP_SECRET=

# アプリ設定の「OAuth Redirect URIs」に登録したURI(https必須)
# ローカル開発では ngrok などでHTTPSのURLを用意する
INSTAGRAM_REDIRECT_URI=https://example.com/auth/callback

# サーバーのポート番号
PORT=3000
